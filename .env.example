# Copier ce fichier en .env puis adapter les valeurs :
#   cp .env.example .env
# Le compose charge automatiquement les variables du fichier .env.
# NE JAMAIS COMMITER .ENV (il est dans .gitignore).

# --- Mot de passe du super-utilisateur Postgres ---
POSTGRES_PASSWORD=mot-de-passe-fort-a-changer

# --- Chaine de connexion du conteneur web (doit matcher ci-dessus) ---
DATABASE_URL=postgresql://user:mot-de-passe-fort-a-changer@db:5432/testdb

# --- Cle du HMAC des courriels (openssl rand -hex 32) ---
SECRET_HMAC=remplacer-par-64-caracteres-hexa
